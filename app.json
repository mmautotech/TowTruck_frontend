{
  "expo": {
    "name": "towly",
    "slug": "towly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "bundleIdentifier": "com.mmitsol.towly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#357EBD"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mmitsol.towly",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCtdSur_kgpmk5z4Olvk6HvhLPx82dUR7o"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "27b3bbbf-0644-4d0e-a876-ffdda036aa4b"
      }
    },
    "plugins": [
      "expo-maps",
      "expo-font"
    ]
  }
}
